# =============================================================================
# Campus+ — environment variables
# =============================================================================
# Copy this file to `.env.local` for local development and configure the same
# keys in Vercel (Project → Settings → Environment Variables) for production.
#
#   cp .env.example .env.local
#
# Never commit `.env.local`. Never put a secret key in a NEXT_PUBLIC_* variable:
# every NEXT_PUBLIC_* value is embedded in the browser bundle.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase — client (safe to expose, protected by Row Level Security)
# -----------------------------------------------------------------------------
# Supabase Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Project Settings → API Keys → "Publishable key" (legacy name: anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# -----------------------------------------------------------------------------
# 2. Supabase — server only (secret, RLS bypassing, NEVER exposed to the browser)
# -----------------------------------------------------------------------------
# Required only by maintenance scripts (seeding, role grants, env checks).
# Project Settings → API Keys → "Secret key" (legacy name: service_role key)
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# -----------------------------------------------------------------------------
# 3. Institutional domain gate (server-side enforced)
# -----------------------------------------------------------------------------
# The authoritative allow-list also lives in the `colleges` table and in
# `platform_settings.allowed_email_domains`; this variable is the deployment
# default used before the database is reachable and by the OAuth callback.
CAMPUS_ALLOWED_EMAIL_DOMAINS=pccoepune.org

# -----------------------------------------------------------------------------
# 4. GIPHY — GIF search (text communication surfaces only)
# -----------------------------------------------------------------------------
# https://developers.giphy.com/dashboard/ → Create an App → API key
# Server-side only: the browser never receives this key, it calls /api/giphy/*.
GIPHY_API_KEY=YOUR_GIPHY_KEY
# Optional. GIPHY requires a non-secret app identifier; defaults to "campus_plus".
GIPHY_CLIENT_ID=campus_plus
# One of: g | pg | pg-13 | r  (kept server-side, defaults to "pg-13")
GIPHY_CONTENT_RATING=pg-13

# -----------------------------------------------------------------------------
# 5. Platform defaults (optional — editable at runtime by Admin/Super Admin)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLATFORM_NAME=Campus+
NEXT_PUBLIC_COLLEGE_NAME=PCCOE

# -----------------------------------------------------------------------------
# 6. Encrypted Google Drive backups (server only — ALL of these are secrets)
# -----------------------------------------------------------------------------
# Existing Drive-only Google OAuth client (NOT the Supabase student sign-in
# client). Google Cloud Console → APIs & Services → Credentials.
# Register this EXACT production redirect URI on that client:
#   https://pccoe.in/api/backup/drive/callback
GOOGLE_DRIVE_CLIENT_ID=YOUR_DRIVE_OAUTH_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=YOUR_DRIVE_OAUTH_CLIENT_SECRET
# Do NOT set in production: the exact URI above is enforced by the application.
# Development only, e.g. http://localhost:3000/api/backup/drive/callback
# BACKUP_DRIVE_REDIRECT_URI=http://localhost:3000/api/backup/drive/callback
# Public origin used to build the development callback when no override is set.
# BACKUP_PUBLIC_ORIGIN=http://localhost:3000

# 32 random bytes, base64-encoded: openssl rand -base64 32
# Rotation: BACKUP_ENCRYPTION_KEYS=primary:<base64>,previous:<base64>
BACKUP_ENCRYPTION_KEYS=YOUR_BASE64_32_BYTE_KEY
# Name of the key used for NEW objects (must exist in BACKUP_ENCRYPTION_KEYS).
BACKUP_ENCRYPTION_KEY_ID=primary

# Direct Postgres connection (Supabase → Connect → Session pooler / direct).
# Required for consistent full snapshots; never expose to the browser.
BACKUP_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
# Separate, disposable database used only by restore/verification scripts.
# BACKUP_RESTORE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/restore_test

# Bearer token required by /api/backup/worker and /api/backup/snapshot.
# IMPORTANT: Vercel Cron can ONLY send the variable literally named CRON_SECRET
# (as `Authorization: Bearer <CRON_SECRET>`). Set CRON_SECRET in Vercel →
# Settings → Environment Variables → Production and redeploy. The endpoints
# accept EITHER name; if you also keep the legacy BACKUP_CRON_SECRET for CLI
# callers, set both to the SAME value. They are never sent to the browser.
CRON_SECRET=YOUR_LONG_RANDOM_CRON_TOKEN
# BACKUP_CRON_SECRET=YOUR_LONG_RANDOM_CRON_TOKEN

# -----------------------------------------------------------------------------
# 7. Legal / rights-holder contact (optional but strongly recommended)
# -----------------------------------------------------------------------------
# Public email address shown on /legal for intellectual-property and other
# rights-holder enquiries. It is a NEXT_PUBLIC_* value (visible to every
# visitor), so use a mailbox intended for public correspondence. Until this
# is set, /legal states that no dedicated address has been published yet —
# the application never invents one.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=YOUR_PUBLIC_CONTACT_EMAIL

# Sandbox preview only (optional). With `npm run perf:serve` running on port
# 3111, set to 1 to proxy browser fixture requests through the Next dev server.
# Ignored in production; never point this preview at real user data.
# NEXT_PUBLIC_LOCAL_PREVIEW=1
