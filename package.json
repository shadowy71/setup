{
  "name": "campus-plus",
  "version": "1.0.0",
  "private": true,
  "description": "Campus+ — an unofficial, text-first digital layer for campus life (PCCOE).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-sw.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "node scripts/check-env.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "role:grant": "node scripts/grant-role.mjs",
    "role:list": "node scripts/list-roles.mjs",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:bundle": "node scripts/build-sql-bundle.mjs",
    "verify:db": "node scripts/dev/validate-migrations.mjs",
    "audit:db": "node scripts/dev/audit.mjs",
    "perf:serve": "node scripts/dev/perf/serve.mjs",
    "perf:measure": "node scripts/dev/perf/measure.mjs",
    "perf:smoke": "node scripts/dev/perf/smoke.mjs",
    "verify": "npm run lint && npm run sw:check && npm run verify:db && npm run audit:db && npm run test",
    "verify:security": "node scripts/verify-security.mjs",
    "backup:worker": "node scripts/backup/worker.mjs",
    "backup:snapshot": "node scripts/backup/snapshot.mjs",
    "backup:restore": "node scripts/backup/restore.mjs",
    "backup:verify-restore": "node scripts/backup/verify-restore.mjs",
    "backup:disconnect": "node scripts/backup/disconnect.mjs",
    "test:contrast": "node scripts/dev/contrast/audit.mjs",
    "brand:icons": "node scripts/dev/brand-icons.mjs",
    "brand:timetable-icons": "node scripts/dev/timetable-icons.mjs",
    "sw:bundle": "node scripts/build-sw.mjs",
    "sw:check": "node scripts/build-sw.mjs --check",
    "verify:offline": "node scripts/dev/timetable-offline-check.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.164.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.8",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.3"
  }
}
