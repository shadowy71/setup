{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm ci --include=dev",
  "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run build",
  "crons": [
    {
      "path": "/api/backup/worker",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/backup/snapshot",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/storage/reconcile",
      "schedule": "0 3 * * *"
    }
  ]
}
